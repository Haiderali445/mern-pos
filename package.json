{
  "name": "mern-pos-monorepo",
  "version": "2.4.0",
  "description": "Hardware Point POS — Enterprise Full-Stack Retail ERP (Clean Architecture)",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm --prefix server start\" \"npm --prefix client start\"",
    "server": "npm --prefix server start",
    "client": "npm --prefix client start",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client run build",
    "test": "npm --prefix client test -- --watchAll=false"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "Haider Ali",
  "license": "SEE LICENSE IN LICENSE"
}
